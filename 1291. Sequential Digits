class Solution{
    List<Integer> ans=new ArrayList<>();
    public List<Integer> sequentialDigits(int low, int high){
        List<Integer> list=new ArrayList<>();
        for(int i=1;i<=8;i++){
            recurse(i,list,low,high);
        }
        Collections.sort(ans);
        return ans;
    }
    public void recurse(int num,List<Integer> list,int low,int high){
        if(num%10==9) return;
        num=num*10+((num%10)+1);
        if(num>=low && num<=high) ans.add(num);
        recurse(num,list,low,high);
    }
}
