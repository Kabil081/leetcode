/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution{
    int ans=0;
    public int countDominantNodes(TreeNode root) {
        int cur=dfs(root);
        return ans;
    }
    public int dfs(TreeNode root){
        if(root==null) return 0;
        int sub_max=Math.max(dfs(root.left),dfs(root.right));
        if(root.val>=sub_max){
            ans++;
            return root.val;
        }
        return sub_max;
    }
}
