class Solution{
    public int maxActiveSectionsAfterTrade(String s){
        List<Integer> segment=new ArrayList<>();
        List<Integer> count=new ArrayList<>();
        int n=s.length();
        int cnt=1;
        int ones=0;
        if(s.charAt(0)=='1') ones++;
        for(int i=1;i<n;i++){
            int prev=s.charAt(i-1)-'0';
            int cur=s.charAt(i)-'0';
            if(cur==1){
                ones++;
            }
            if(prev!=cur){
                segment.add(prev);
                count.add(cnt);
                cnt=1;
            }else{
                cnt++;
            }
        }
        segment.add(s.charAt(n-1)-'0');
        count.add(cnt);
        int max=0;
        for(int i=1;i<count.size()-1;i++){
            if(segment.get(i)==1){
                max=Math.max(max,count.get(i-1)+count.get(i+1));
            }
        }
        return ones+max;
    }
}
